{
  "fixture": "invoice_payment_status",
  "purpose": "Exercises the refactored paid-cents / invoice-status logic in invoice_providers.dart. After extracting paidCentsByInvoiceProvider, the 'sum non-void payments' rule lives in one place (paidCentsByInvoice) and feeds invoiceStatusOf, invoiceRowsProvider (list tabs + grouping), and invoiceDetailProvider (paidCents/balanceDue). This fixture asserts identical behaviour across all of those.",

  "rules_under_test": {
    "paid_cents": "amount paid per invoice = SUM(amount) over its payments WHERE isVoid = 0. Voided payments are kept but excluded.",
    "fully_paid": "isInvoiceFullyPaid == (totalAmount > 0 && paidCents >= totalAmount - 1). Note the 1-cent tolerance and the totalAmount>0 guard.",
    "status_ladder": "voided if isDeleted != 0; else paid if fully paid; else partial if paidCents > 0; else sent if isSent != 0; else draft.",
    "money_unit": "all *Amount / amount fields are integer CENTS. balanceDue is reported in DOLLARS = (totalAmount - paidCents) / 100.",
    "list_tabs": "active tab = isDeleted==0 && !fullyPaid; paid tab = isDeleted==0 && fullyPaid; voided view (showVoided=true) = isDeleted != 0.",
    "grouping": "list rows are grouped by project name (sorted asc); group total (dollars) = SUM(totalAmount)/100 over its rows; rows within a group sorted by invoiceDate DESC.",
    "paid_map_keys": "paidCentsByInvoice only emits a key for invoices that have >=1 non-void payment. Invoices with none are absent from the map; consumers read `paid[id] ?? 0`."
  },

