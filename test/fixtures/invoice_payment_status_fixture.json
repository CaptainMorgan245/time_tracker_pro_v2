      "4": { "status": "paid",    "case": "exact full payment" },
      "5": { "status": "paid",    "case": "VERIFY #4 — 1 cent short (9999/10000), tolerance applies" },
      "6": { "status": "partial", "case": "VERIFY #5 — 2 cents short (9998/10000), tolerance does NOT apply" },
      "7": { "status": "partial", "case": "VERIFY #6 — void payment excluded; paid=6000 not 11000" },
      "8": { "status": "voided",  "case": "VERIFY #7 — isDeleted overrides a full payment" },
      "9": { "status": "draft",   "case": "VERIFY #8 — totalAmount=0 is NOT 'paid' (guard totalAmount>0)" }
    },

    "invoiceDetail": {
